# secrets — never commit these
**/.env
**/.env.*
!**/.env.example
backend/config/master.key

# logs
*.log
**/log/*
!**/log/.keep

# build artefacts
backend/tmp/*
!backend/tmp/.keep
frontend/dist/
frontend/node_modules/

# DB backups (large pg_dump files — keep locally, don't commit)
backend/db/backups/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
