# ═══════════════════════════════════════════════════════════
# Backend environment — used by docker-compose.yml
# These values match the docker-compose service names and ports
# ═══════════════════════════════════════════════════════════

# ── Database (points to the 'postgres' service inside Docker) ──
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

# ── Redis (points to the 'redis' service inside Docker) ────────
REDIS_URL=

# ── Rails ───────────────────────────────────────────────────────
RAILS_ENV=
SECRET_KEY_BASE=

# ── JWT (Devise-JWT) ────────────────────────────────────────────
# Generate for production: openssl rand -hex 64
DEVISE_JWT_SECRET_KEY=

# ── Encryption (Lockbox) ────────────────────────────────────────
# Generate for production: ruby -e "require 'lockbox'; puts Lockbox.generate_key"
LOCKBOX_MASTER_KEY=

# ── OpenSearch (points to 'opensearch' service inside Docker) ───
OPENSEARCH_URL=

# ── CORS / Frontend origin ──────────────────────────────────────
# During development the Vite dev server runs at 5174 on the host
FRONTEND_URL=

# ── Shopify integration ─────────────────────────────────────────
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=

# ── Webhook tunnel (for local webhook delivery) ─────────────────
# Run: cloudflared tunnel --url http://localhost:3010
WEBHOOK_BASE_URL=

# ── Seeds ───────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Security ────────────────────────────────────────────────────
WEBHOOKS_HMAC_BYPASS=

# ═══════════════════════════════════════════════════════════
# Production-only (Render + Neon). Leave blank in dev.
# ═══════════════════════════════════════════════════════════

# Render reads this to decrypt config/credentials.yml.enc.
# Value is the contents of backend/config/master.key (never commit that file).
RAILS_MASTER_KEY=

# Neon Postgres connection string. Must include ?sslmode=require.
DATABASE_URL=

# Production Vercel URL (added to CORS allowed origins).
FRONTEND_ORIGIN=

# Public URL Shopify uses to deliver webhooks (the Render service URL in prod).
SHOPIFY_WEBHOOK_BASE_URL=

# Shopify::Client is read-only by default. Leave READ_ONLY_SHOPIFY=true to block
# every REST write and GraphQL mutation, including webhook registration.
READ_ONLY_SHOPIFY=true
# Set SHOPIFY_WRITES_ENABLED=true only for an intentional one-off write task.
SHOPIFY_WRITES_ENABLED=false

# Render free plan has no separate worker dyno — run Solid Queue in Puma.
SOLID_QUEUE_IN_PUMA=false
