# Production environment template — copy to `.env.production` and fill in.
# DO NOT COMMIT the populated file.

POSTGRES_USER=erp
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=erp_production

# Rails — generate with `bin/rails secret`
SECRET_KEY_BASE=

# Required for encrypted credentials. Copy from `backend/config/master.key`.
RAILS_MASTER_KEY=

# Shopify Admin API
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# Public origin (used for CSRF and webhooks)
APP_ORIGIN=https://erp.example.com

# Image refs (override via CI/CD)
BACKEND_IMAGE=ghcr.io/your-org/shopify_erp_2-backend:latest
